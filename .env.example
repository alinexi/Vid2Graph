# ─────────────────────────────────────────────────────────────────────────────
# Vid2Graph configuration — local-first defaults. Copy to .env and edit.
# Every value is optional; the defaults below run fully offline with Ollama.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
# Provider preset: ollama | lmstudio | vllm | openai | anthropic | gemini | groq | openrouter | openai_compatible | mock
# Hosted API example (no local model, no GPU):
#   VID2GRAPH_LLM_PROVIDER=anthropic  VID2GRAPH_LLM_MODEL=claude-haiku-5-5  VID2GRAPH_LLM_API_KEY=sk-ant-...
VID2GRAPH_LLM_PROVIDER=ollama
# Model name as the provider knows it (Ollama: `ollama pull qwen2.5:7b`)
VID2GRAPH_LLM_MODEL=qwen2.5:7b
# Base URL of the provider. Ollama default shown; LM Studio is http://localhost:1234/v1,
# vLLM is http://localhost:8000/v1. Inside docker-compose use host.docker.internal.
VID2GRAPH_LLM_BASE_URL=http://localhost:11434
# API key — only needed for OpenAI / hosted endpoints. Never required locally.
VID2GRAPH_LLM_API_KEY=
# Structured-output mode for Instructor: json (safest for small local models) | tools | md_json
VID2GRAPH_LLM_STRUCTURED_MODE=json
VID2GRAPH_LLM_TEMPERATURE=0.1
VID2GRAPH_LLM_MAX_RETRIES=2
VID2GRAPH_LLM_TIMEOUT=180

# ── Embeddings (entity resolution / node merging) ────────────────────────────
# auto tries: ollama → sentence-transformers → hash (pure-python fallback, no deps)
VID2GRAPH_EMBEDDING_PROVIDER=auto
VID2GRAPH_EMBEDDING_MODEL=nomic-embed-text
VID2GRAPH_EMBEDDING_BASE_URL=http://localhost:11434
# Cosine similarity above which two concept names are merged into one node
VID2GRAPH_MERGE_THRESHOLD=0.85

# ── Speech-to-text (only used when no captions are available) ────────────────
# Backend: auto | faster-whisper | mlx | whisper.cpp | none
VID2GRAPH_WHISPER_BACKEND=auto
# faster-whisper size: tiny | base | small | medium | large-v3 | distil-large-v3
VID2GRAPH_WHISPER_MODEL=base
# cuda | cpu | auto
VID2GRAPH_WHISPER_DEVICE=auto
# int8 (CPU friendly) | float16 (CUDA) | auto
VID2GRAPH_WHISPER_COMPUTE_TYPE=auto
# whisper.cpp only
VID2GRAPH_WHISPER_CPP_BIN=whisper-cli
VID2GRAPH_WHISPER_CPP_MODEL=

# ── Chunking ─────────────────────────────────────────────────────────────────
VID2GRAPH_CHUNK_MINUTES=6
VID2GRAPH_CHUNK_OVERLAP_SECONDS=45

# ── Storage / server ─────────────────────────────────────────────────────────
VID2GRAPH_DATA_DIR=./data
VID2GRAPH_HOST=0.0.0.0
VID2GRAPH_PORT=8000
# Comma-separated origins allowed to call the API
VID2GRAPH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Seed the Distributed-Systems demo graph on first boot
VID2GRAPH_SEED_DEMO=true
# Optional: attach a YouTube URL or media file path to the demo graph's player
VID2GRAPH_DEMO_MEDIA_URL=

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
